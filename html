<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clean Video Player</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h1>Distraction-Free Viewer</h1>
        <div class="input-area">
            <input type="text" id="videoLink" placeholder="Paste YouTube URL here...">
            <button onclick="loadVideo()">Watch</button>
        </div>
        <!-- The video will appear inside this div -->
        <div id="playerContainer" class="video-container"></div>
    </div>
    <script src="script.js"></script>
</body>
</html>
